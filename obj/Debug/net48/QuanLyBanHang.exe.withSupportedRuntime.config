<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Sửa Server cho đúng máy của bạn: .\SQLEXPRESS, (localdb)\MSSQLLocalDB, hoặc tên máy\SQLEXPRESS -->
    <add name="HangHoa" connectionString="Server=(localdb)\MSSQLLocalDB;Database=HangHoa;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>